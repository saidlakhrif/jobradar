{
  "functions": {
    "server.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "server.js"
    }
  },
  "routes": [
    { "src": "/api/search", "dest": "/server.js" },
    { "src": "/api/adapt", "dest": "/server.js" },
    { "src": "/api/health", "dest": "/server.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
