{
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/search", "dest": "/server.js" },
    { "src": "/api/adapt", "dest": "/server.js" },
    { "src": "/api/health", "dest": "/server.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
